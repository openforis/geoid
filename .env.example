# ---------------------------------------------------------------------------
# GeoID configuration (environment-driven; pydantic-settings reads GEOID_*).
# Copy to .env and adjust. The core image imports no GCP SDK — everything here
# is portable between FAO GCP and an on-prem docker-compose deployment.
# ---------------------------------------------------------------------------

# Async SQLAlchemy URL (asyncpg driver). For docker-compose the host is `db`.
GEOID_DATABASE_URL=postgresql+asyncpg://geoid:geoid@localhost:5432/geoid

# Public base URL used to derive URI / OGC item links on read. Keep it the BARE origin:
# the "/geoid" segment in minted URIs comes from GEOID_ROOT_PATH (below), which is
# prepended to this value. Demo target: GEOID_BASE_URL=https://data.fao.org +
# GEOID_ROOT_PATH=/geoid  ->  https://data.fao.org/geoid/<uuid>
GEOID_BASE_URL=http://localhost:8000

# Sub-path the API is mounted under behind a reverse proxy (e.g. a Cloud HTTPS LB).
# Empty = served at root. Set to "/geoid" to expose the API at
# <BASE_URL>/geoid and Swagger at <BASE_URL>/geoid/docs. The prefix is also
# prepended to BASE_URL when minting URIs/links, so leave BASE_URL as the bare origin.
# The proxy must strip this prefix before forwarding to the app.
GEOID_ROOT_PATH=

# Deployment mode: "development" (default), "review", or "production". Outside
# development the service refuses to start unless OIDC is configured (the issuer +
# JWKS URL below) — Keycloak is the only authentication path, so a missing env var
# can never leave a deployed environment with zero auth.
GEOID_ENVIRONMENT=development

# Reserved collection slug that accepts anonymous writes (public_write=true).
GEOID_PUBLIC_COLLECTION=public

# This instance's id, stamped into provenance + place.originating_instance
# (federation seam). Central = "fao-central"; a country = e.g. "ke-nairobi".
GEOID_INSTANCE_ID=fao-central

# Synchronous bulk write. Hard cap on features per bulk POST FeatureCollection; a
# write bound MUST error (413), never silently truncate — exceeding it rejects the
# whole request.
GEOID_BULK_MAX_FEATURES=1000

# HTTP-caching trial on the two public resolvers (GET /{geoid} and
# GET /collections/{id}/external/{external_id}): seconds of Cache-Control max-age
# granted to ANONYMOUS 200s, which also carry a strong per-representation ETag
# ("{geoid}:{format}:{salt}"; the salt rotates on app-version/base-URL change)
# + Vary and answer a matching If-None-Match with 304.
# Authenticated responses are marked "private, no-store" (no ETag, never a 304).
# 0 (default) = trial fully off — responses and /openapi.json byte-identical to
# before the flag. The deployed review env trials 3600; releases (prod) keep 0.
# GEOID_RESOLVER_CACHE_MAX_AGE=0

# Geometry identity/dedup precision: the identity-lattice cell size in decimal
# degrees per vertex. 1e-7 ≈ 1cm — exact-match semantics (absorbs float jitter
# only; it does NOT merge nearby shapes), per the team's final ruling. ONE global
# lattice (geometry uniqueness is catalog-wide; a duplicate POST → 201 with the
# existing geoid and no second row). Documentation-only: the app never passes it to the DB — recipe v2
# quantizes by the integer SCALE 10^7 pinned in migration 0008 (and mirrored by
# domain/geometry_identity.py); a unit test pins SCALE == round(1/this value).
# Retune via a migration (an identity-version event), never by editing this alone.
# GEOID_DEDUP_GRID_DEFAULT=1e-7

# --- OIDC / Keycloak resource-server auth — the ONLY authentication path ------------
# The service accepts Keycloak access tokens (RS256, audience geoid-be), mapping
# `geoid.sysadmin` to the global admin tier and per-collection owner/editor/viewer to
# GeoID-DB grants. Leaving issuer + JWKS URL unset (development only) makes the service
# anonymous-only: every bearer credential is rejected. REQUIRED outside development —
# the service refuses to boot without them. The audience defaults to geoid-be and is
# validated only when OIDC is enabled — setting it alone does NOT enable OIDC.
# GEOID_OIDC_ISSUER=https://<keycloak-host>/realms/<realm>
# GEOID_OIDC_JWKS_URL=https://<keycloak-host>/realms/<realm>/protocol/openid-connect/certs
# GEOID_OIDC_AUDIENCE=geoid-be
# GEOID_OIDC_ROLES_CLIENT=geoid-roles      # resource_access client whose roles[] holds GeoID roles
# GEOID_OIDC_ADMIN_ROLE=geoid.sysadmin     # role granting the global sysadmin tier
# GEOID_OIDC_LEEWAY_SECONDS=30             # clock-skew tolerance (seconds) for exp/nbf

# --- Swagger OAuth2 (Authorization Code + PKCE) — OFF by default --------------------
# The /docs "paste a bearer" button always works (it carries a Keycloak JWT). This
# flag ALSO renders the interactive Keycloak login button; it needs OIDC enabled (the
# auth/token URLs derive from the issuer) and the redirect URI registered on the SPA
# client. Off → /openapi.json and /docs are byte-identical to today.
# GEOID_SWAGGER_OAUTH2_ENABLED=false
# GEOID_SWAGGER_OAUTH2_CLIENT_ID=geoid-fe
